{
  "name": "@opendraft/metadata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YAML metadata parsing, validation, and compilation for OpenDraft manuscripts.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate-types": "tsx scripts/generate-types.ts"
  },
  "dependencies": {
    "@opendraft/references": "workspace:*",
    "@opendraft/schema": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opendraft.dev/schemas/author.schema.json",
  "title": "Author Metadata",
  "description": "Schema for _author.yml — author information.",
  "type": "object",
  "properties": {
    "authors": {
      "type": "array",
      "description": "List of authors.",
      "items": {
        "$ref": "#/definitions/authorObject"
      }
    },
    "affiliations": {
      "type": "array",
      "description": "Registry of affiliations; authors reference entries via {ref}.",
      "items": {
        "$ref": "#/definitions/registryAffiliation"
      }
    }
  },
  "required": ["authors"],
  "additionalProperties": true,
  "definitions": {
    "structuredName": {
      "type": "object",
      "description": "Structured personal name: family name required, given names optional.",
      "properties": {
        "given": {
          "type": "string",
          "description": "Given name(s)."
        },
        "family": {
          "type": "string",
          "description": "Family name."
        },
        "particle": {
          "type": "string",
          "description": "Name particle such as van, de, bin."
        },
        "suffix": {
          "type": "string",
          "description": "Name suffix such as Jr., III."
        }
      },
      "required": ["family"],
      "additionalProperties": true
    },
    "literalName": {
      "type": "object",
      "description": "Literal name for groups and consortia.",
      "properties": {
        "literal": {
          "type": "string",
          "description": "Full literal group or consortium name."
        }
      },
      "required": ["literal"],
      "additionalProperties": true
    },
    "nameValue": {
      "description": "Author name: plain string, structured name, or literal group name.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/structuredName"
        },
        {
          "$ref": "#/definitions/literalName"
        }
      ]
    },
    "affiliationRef": {
      "type": "object",
      "description": "Reference to a top-level affiliation registry entry.",
      "properties": {
        "ref": {
          "type": "string",
          "description": "id of an entry in the top-level affiliations registry."
        }
      },
      "required": ["ref"],
      "additionalProperties": false
    },
    "authorObject": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/nameValue"
        },
        "id": {
          "type": "string",
          "description": "Stable hidden identifier used for cross-references (affiliation refs, on-behalf-of)."
        },
        "email": {
          "type": "string",
          "description": "Contact email for the author."
        },
        "phone": {
          "type": "string",
          "description": "Contact phone for the author."
        },
        "fax": {
          "type": "string",
          "description": "Contact fax for the author."
        },
        "url": {
          "type": "string",
          "description": "URL for the author."
        },
        "degrees": {
          "type": "array",
          "description": "Academic titles or professional certifications.",
          "items": {
            "type": "string"
          }
        },
        "orcid": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$",
          "description": "ORCID identifier (16 digits with hyphens, last digit may be X)."
        },
        "note": {
          "type": "string",
          "description": "Notes to attach to the author."
        },
        "acknowledgements": {
          "type": "string",
          "description": "Author's acknowledgements."
        },
        "roles": {
          "type": "array",
          "description": "Author's roles (CRediT contributor roles).",
          "items": {
            "enum": [
              "conceptualization",
              "data-curation",
              "formal-analysis",
              "funding-acquisition",
              "investigation",
              "methodology",
              "project-administration",
              "resources",
              "software",
              "supervision",
              "validation",
              "visualization",
              "writing-original-draft",
              "writing-review-editing"
            ]
          }
        },
        "corresponding": {
          "type": "boolean",
          "description": "Whether this author is the corresponding author."
        },
        "equal-contributor": {
          "type": "boolean",
          "description": "Whether this author contributed equally."
        },
        "deceased": {
          "type": "boolean",
          "description": "Whether this author is deceased."
        },
        "on-behalf-of": {
          "type": "string",
          "description": "id of the group author this author signs on behalf of."
        },
        "affiliations": {
          "type": "array",
          "description": "Author affiliations: registry refs or inline objects (legacy).",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/affiliationRef"
              },
              {
                "$ref": "#/definitions/affiliationObject"
              }
            ]
          }
        },
        "members": {
          "type": "array",
          "description": "Members of a group or consortium author.",
          "items": {
            "$ref": "#/definitions/memberObject"
          }
        },
        "metadata": {
          "type": "object",
          "description": "Quarto-safe metadata bag for extra author keys.",
          "properties": {
            "author-type": {
              "type": "string",
              "enum": ["person", "group"],
              "description": "Explicit author type; when absent, a literal-only name is treated as a group."
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["name"],
      "additionalProperties": true
    },
    "memberObject": {
      "type": "object",
      "description": "Member of a group or consortium author.",
      "properties": {
        "name": {
          "$ref": "#/definitions/nameValue"
        },
        "orcid": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$",
          "description": "ORCID identifier (16 digits with hyphens, last digit may be X)."
        },
        "affiliations": {
          "type": "array",
          "description": "Member affiliations as registry refs.",
          "items": {
            "$ref": "#/definitions/affiliationRef"
          }
        }
      },
      "required": ["name"],
      "additionalProperties": true
    },
    "affiliationObject": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Institution or organization name."
        },
        "department": {
          "type": "string",
          "description": "Department within the affiliation."
        },
        "group": {
          "type": "string",
          "description": "Team or research group within the affiliation."
        },
        "city": {
          "type": "string",
          "description": "City of the affiliation."
        },
        "region": {
          "type": "string",
          "description": "Region of the affiliation."
        },
        "state": {
          "type": "string",
          "description": "State of the affiliation."
        },
        "country": {
          "type": "string",
          "description": "Country of the affiliation."
        },
        "postal-code": {
          "type": "string",
          "description": "Postal code of the affiliation."
        },
        "url": {
          "type": "string",
          "description": "URL of the affiliation."
        },
        "isni": {
          "type": "string",
          "description": "16-digit International Standard Name Identifier as a string."
        },
        "ringgold": {
          "type": "string",
          "description": "4-6 digit Ringgold ID as a string."
        },
        "ror": {
          "type": "string",
          "description": "Research Organization Registry (ROR) ID."
        },
        "id": {
          "type": "string",
          "description": "Identifier for referencing this affiliation."
        }
      },
      "required": ["name"],
      "additionalProperties": true
    },
    "registryAffiliation": {
      "description": "Registry affiliation: an affiliation object with a required id.",
      "allOf": [
        {
          "$ref": "#/definitions/affiliationObject"
        },
        {
          "type": "object",
          "required": ["id"]
        }
      ]
    }
  }
}

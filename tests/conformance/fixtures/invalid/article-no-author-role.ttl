# Invalid fixture: publication with no pro:author role
#
# Violates protocol/article.shacl.ttl — a publication must have at
# least one author role (pro:withRole pro:author) and exactly one role
# must head the oco:hasNext author chain. The only role present is a
# CRediT role, so no author role exists.

@prefix od: <urn:opendraft:ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix scoro: <http://purl.org/spar/scoro/> .
@prefix credit: <https://credit.niso.org/contributor-roles/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ex: <https://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:invalid-publication
    a od:Publication ;
    dcterms:title "Publication without an author role" ;
    dcterms:creator ex:alice ;
    dcterms:identifier <https://doi.org/10.5555/example-no-author-role> ;
    od:repositoryUrl "https://github.com/opendraft/opendraft"^^xsd:anyURI ;
    od:manuscriptPath "manuscripts/article.qmd" ;
    od:sourceRevision "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d" ;
    od:protocolRevision "0000000000000000000000000000000000000000" ;
    pro:isDocumentContextFor ex:credit-role , ex:affiliate-role .

ex:credit-role
    a pro:RoleInTime ;
    pro:withRole credit:investigation , scoro:corresponding-author ;
    pro:isHeldBy ex:alice .

ex:affiliate-role
    a pro:RoleInTime ;
    pro:withRole scoro:affiliate ;
    pro:isHeldBy ex:alice ;
    pro:relatesToOrganization ex:org .

ex:alice
    a foaf:Person ;
    foaf:givenName "Alice" ;
    foaf:familyName "Smith" ;
    foaf:mbox <mailto:alice@example.edu> .

ex:org
    a foaf:Organization ;
    foaf:name "University of Indonesia" .

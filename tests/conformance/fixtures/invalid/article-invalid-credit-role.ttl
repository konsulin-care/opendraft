# Invalid fixture: role value outside the allowed CRediT/PRO/SCoRO set
#
# Violates protocol/article.shacl.ttl — pro:withRole values on a
# pro:RoleInTime node are restricted (sh:in) to the 14 NISO CRediT
# IRIs plus the PRO/SCoRO authorship roles. The author role here
# carries an invented credit:cooking value. The authorship structure
# is otherwise fully conforming, so the bad role value is the only
# defect.

@prefix od: <urn:opendraft:ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix scoro: <http://purl.org/spar/scoro/> .
@prefix credit: <https://credit.niso.org/contributor-roles/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ex: <https://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:invalid-publication
    a od:Publication ;
    dcterms:title "Publication with a non-CRediT role value" ;
    dcterms:creator ex:alice ;
    dcterms:identifier <https://doi.org/10.5555/example-invalid-credit-role> ;
    od:repositoryUrl "https://github.com/opendraft/opendraft"^^xsd:anyURI ;
    od:manuscriptPath "manuscripts/article.qmd" ;
    od:sourceRevision "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d" ;
    od:protocolRevision "0000000000000000000000000000000000000000" ;
    frbr:realizationOf ex:invalid-work ;
    pro:isDocumentContextFor ex:author-role , ex:affiliate-role .

ex:author-role
    a pro:RoleInTime ;
    pro:withRole pro:author ,
                 scoro:corresponding-author ,
                 credit:cooking ;
    pro:isHeldBy ex:alice .

ex:affiliate-role
    a pro:RoleInTime ;
    pro:withRole scoro:affiliate ;
    pro:isHeldBy ex:alice ;
    pro:relatesToOrganization ex:org .

ex:alice
    a foaf:Person ;
    foaf:givenName "Alice" ;
    foaf:familyName "Smith" ;
    foaf:mbox <mailto:alice@example.edu> .

ex:org
    a foaf:Organization ;
    foaf:name "University of Indonesia" .

ex:invalid-work
    a fabio:Work ;
    dcterms:title "Invalid fixture work" .

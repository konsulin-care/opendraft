# Invalid fixture: publication with a non-SHA od:sourceRevision
#
# Violates protocol/article.shacl.ttl — od:sourceRevision must match
# sh:pattern ^[0-9a-f]{40}$. This value is short and non-hexadecimal.
# The OCDM authorship structure is otherwise fully conforming, so the
# bad revision is the only defect.

@prefix od: <urn:opendraft:ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix scoro: <http://purl.org/spar/scoro/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ex: <https://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:invalid-publication
    a od:Publication ;
    dcterms:title "Publication with a bad source revision" ;
    dcterms:creator ex:alice ;
    dcterms:identifier <https://doi.org/10.5555/example-invalid-revision> ;
    od:repositoryUrl "https://github.com/opendraft/opendraft"^^xsd:anyURI ;
    od:manuscriptPath "manuscripts/article.qmd" ;
    od:sourceRevision "not-a-sha" ;
    od:protocolRevision "0000000000000000000000000000000000000000" ;
    frbr:realizationOf ex:invalid-work ;
    pro:isDocumentContextFor ex:author-role , ex:affiliate-role .

ex:author-role
    a pro:RoleInTime ;
    pro:withRole pro:author , scoro:corresponding-author ;
    pro:isHeldBy ex:alice .

ex:affiliate-role
    a pro:RoleInTime ;
    pro:withRole scoro:affiliate ;
    pro:isHeldBy ex:alice ;
    pro:relatesToOrganization ex:org .

ex:alice
    a foaf:Person ;
    foaf:givenName "Alice" ;
    foaf:familyName "Smith" ;
    foaf:mbox <mailto:alice@example.edu> .

ex:org
    a foaf:Organization ;
    foaf:name "University of Indonesia" .

ex:invalid-work
    a fabio:Work ;
    dcterms:title "Invalid fixture work" .

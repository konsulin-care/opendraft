# Invalid fixture: person author without an affiliation
#
# Violates protocol/article.shacl.ttl — a person author must hold a
# scoro:affiliate role. ex:alice holds no affiliate role; everything
# else conforms, so the missing affiliation is the only defect.

@prefix od: <urn:opendraft:ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix scoro: <http://purl.org/spar/scoro/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ex: <https://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:invalid-publication
    a od:Publication ;
    dcterms:title "Publication whose person author has no affiliation" ;
    dcterms:creator ex:alice ;
    dcterms:identifier <https://doi.org/10.5555/example-person-without-affiliation> ;
    od:repositoryUrl "https://github.com/opendraft/opendraft"^^xsd:anyURI ;
    od:manuscriptPath "manuscripts/article.qmd" ;
    od:sourceRevision "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d" ;
    od:protocolRevision "0000000000000000000000000000000000000000" ;
    frbr:realizationOf ex:invalid-work ;
    pro:isDocumentContextFor ex:author-role .

ex:author-role
    a pro:RoleInTime ;
    pro:withRole pro:author , scoro:corresponding-author ;
    pro:isHeldBy ex:alice .

ex:alice
    a foaf:Person ;
    foaf:givenName "Alice" ;
    foaf:familyName "Smith" ;
    foaf:mbox <mailto:alice@example.edu> .

ex:invalid-work
    a fabio:Work ;
    dcterms:title "Invalid fixture work" .

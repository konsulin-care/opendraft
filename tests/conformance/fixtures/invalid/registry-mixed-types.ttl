# Invalid fixture: registry whose frbr:part mixes a publication and a
# collection
#
# Violates protocol/registry.shacl.ttl — frbr:part values must be
# either only od:Publication or only fabio:ExpressionCollection,
# never both. The child registry below is itself valid so the mixing
# node is the sole violator. Parses as valid Turtle but must FAIL
# registry SHACL validation.

@prefix od: <https://w3id.org/opendraft/ontology#> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://example.org/mixed-registry>
    a fabio:ExpressionCollection ;
    dcterms:title "Mixed registry" ;
    frbr:part <https://example.org/example-publication> ,
              <https://example.org/example-child-registry> .

<https://example.org/example-publication>
    a od:Publication .

# The child registry conforms on its own: only publications in frbr:part.
<https://example.org/example-child-registry>
    a fabio:ExpressionCollection ;
    frbr:part <https://example.org/example-publication> .

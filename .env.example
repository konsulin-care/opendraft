# OpenDraft BFF configuration.
# Copy to .env and fill in values. Never commit real secrets.
# All variables are read by apps/bff/internal/config.

# Listen address of the BFF HTTP server.
BFF_ADDR=:8080

# Public origin without a trailing slash. The OAuth callback is
# BFF_PUBLIC_ORIGIN + /@api/auth/callback.
# Local dev example:
BFF_PUBLIC_ORIGIN=http://127.0.0.1:8080
# Production example (Tailscale hostname):
# BFF_PUBLIC_ORIGIN=https://publish.example.ts.net

# Directory containing the built web app. Empty disables static serving.
BFF_STATIC_DIR=/srv/web

# Optional: leave all three GitHub App variables empty to serve anonymously.
# With none of them set, the BFF starts in anonymous read-only mode: sign-in,
# repository creation, conversion, and the git relay are disabled and answer
# 403 {"error":"login_disabled"}. A partial set refuses to start and names the
# missing variables.

# GitHub App OAuth client id.
# BFF_GITHUB_CLIENT_ID=your-github-app-client-id

# GitHub App OAuth client secret. Set either this variable or the _FILE variant.
# BFF_GITHUB_CLIENT_SECRET=your-github-app-client-secret
# Path to a file containing the client secret. Takes effect when
# BFF_GITHUB_CLIENT_SECRET is empty.
# BFF_GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_client_secret

# URL slug of the GitHub App.
# BFF_GITHUB_APP_SLUG=your-github-app-slug

# Optional GitHub App private key (raw PEM). Enables repo-level installation
# checks via GET /repos/{owner}/{repo}/installation with an app JWT, so outside
# contributors see installations on organizations they do not belong to.
# Leave empty to keep the user-token-only behaviour. The key is optional even
# when login is enabled.
# Paste the PEM exactly as downloaded from the GitHub App settings
# (Credentials > Key pairs > New key), including the BEGIN/END lines. A quoted
# multiline value works; literal \n escapes are also accepted.
# BFF_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Never commit the real key. Rotate by adding a new key on GitHub, deploying it
# here, then deleting the old key.
# BFF_GITHUB_APP_PRIVATE_KEY=

# Base64-encoded 32-byte session encryption key. Only needed when the GitHub
# App credentials above are set; leave empty for anonymous mode. The value
# below is a non-secret development placeholder; generate a real key with:
#   openssl rand -base64 32
# BFF_SESSION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Path to a file containing the session key. Takes effect when
# BFF_SESSION_KEY is empty.
# BFF_SESSION_KEY_FILE=/run/secrets/session_key

# Optional previous session key, used to open cookies during key rotation.
# BFF_SESSION_KEY_PREVIOUS=

# GitHub web frontend base URL.
BFF_GITHUB_WEB_URL=https://github.com

# GitHub REST API base URL.
BFF_GITHUB_API_URL=https://api.github.com

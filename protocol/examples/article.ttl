# OpenDraft Example Article
#
# A canonical example publication demonstrating the OCDM authorship
# pattern (ADR-021): author roles linked from the publication via
# pro:isDocumentContextFor, ordered in a single oco:hasNext chain, and
# held by agents (pro:isHeldBy). Affiliations are scoro:affiliate roles
# relating the author to a ROR-identified organization.
#
# Demonstrates: an ORCID corresponding author, a non-ORCID person
# writing on behalf of a named group, a group author with members,
# equal contribution (scoro:isEqualToRoleInTime), affiliations shared
# between authors, CRediT roles, keywords and a subject assignment.
#
# Validates clean against protocol/article.shacl.ttl.

@prefix od: <urn:opendraft:ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix scoro: <http://purl.org/spar/scoro/> .
@prefix oco: <https://w3id.org/oc/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix credit: <https://credit.niso.org/contributor-roles/> .
@prefix prism: <http://prismstandard.org/namespaces/basic/2.0/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The publication itself. Identified by version DOI; carries full
# provenance scalars plus the authorship document context.
od:example-publication
    a od:Publication ;

    dcterms:title "Example Publication: OpenDraft Protocol" ;
    dcterms:creator <https://orcid.org/0000-0002-1825-0097> ,
                    _:budi-lee ,
                    od:group-who-diabetes ;
    dcterms:identifier <https://doi.org/10.5555/example-opendraft-2026> ;
    od:repositoryUrl "https://github.com/konsulin-care/opendraft"^^xsd:anyURI ;
    od:manuscriptPath "manuscripts/distributed-scientific-publication/article.qmd" ;
    od:sourceRevision "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d" ;
    od:protocolRevision "0000000000000000000000000000000000000000" ;

    dcterms:abstract "A canonical example publication used to demonstrate the OpenDraft protocol." ;

    # Authorship roles live in the document context of the publication.
    pro:isDocumentContextFor od:role-alice-author ,
                             od:role-alice-ui ,
                             od:role-alice-rscm ,
                             od:role-budi-author ,
                             od:role-budi-rscm ,
                             od:role-group-author ;

    prism:keyword "distributed scientific publication" ,
                  "research data" ;
    fabio:hasSubjectTerm od:concept-distributed-scientific-publication ;
    dcterms:subject od:concept-distributed-scientific-publication ;
    od:hasAssignment _:subject-assignment .

# A reified subject assignment binding the SKOS term with provenance.
_:subject-assignment
    a od:SubjectAssignment ;
    od:assignedSubject od:concept-distributed-scientific-publication ;
    od:assignedBy <https://orcid.org/0000-0002-1825-0097> ;
    od:assignedAt "2026-01-15T09:00:00"^^xsd:dateTime .

od:concept-distributed-scientific-publication
    a skos:Concept , fabio:SubjectTerm ;
    skos:prefLabel "Distributed scientific publication"@en .

# --- Author order: Alice Marie Smith, Budi Lee, WHO Diabetes Work Group ---

# Head of the oco:hasNext author chain; also the corresponding author
# and an equal contributor. Carries CRediT roles alongside the PRO and
# SCoRO role values.
od:role-alice-author
    a pro:RoleInTime ;
    pro:withRole pro:author ,
                 scoro:corresponding-author ,
                 credit:conceptualization ,
                 credit:writing-original-draft ;
    pro:isHeldBy <https://orcid.org/0000-0002-1825-0097> ;
    scoro:isEqualToRoleInTime od:role-budi-author ;
    oco:hasNext od:role-budi-author .

# Affiliate roles: one per affiliation, each pointing at one
# ROR-identified organization. Alice shares rscm with Budi.
od:role-alice-ui
    a pro:RoleInTime ;
    pro:withRole scoro:affiliate ;
    pro:isHeldBy <https://orcid.org/0000-0002-1825-0097> ;
    pro:relatesToOrganization <https://ror.org/0116zj450> .

od:role-alice-rscm
    a pro:RoleInTime ;
    pro:withRole scoro:affiliate ;
    pro:isHeldBy <https://orcid.org/0000-0002-1825-0097> ;
    pro:relatesToOrganization <https://ror.org/05dxgng32> .

<https://orcid.org/0000-0002-1825-0097>
    a foaf:Person ;
    foaf:givenName "Alice Marie" ;
    foaf:familyName "Smith" ;
    foaf:mbox <mailto:alice.smith@example.edu> .

# Second author: no ORCID, holds the author role on behalf of the
# group, equal contributor, CRediT roles.
od:role-budi-author
    a pro:RoleInTime ;
    pro:withRole pro:author ,
                 credit:investigation ,
                 credit:software ;
    pro:isHeldBy _:budi-lee ;
    od:onBehalfOf od:group-who-diabetes ;
    scoro:isEqualToRoleInTime od:role-alice-author ;
    oco:hasNext od:role-group-author .

od:role-budi-rscm
    a pro:RoleInTime ;
    pro:withRole scoro:affiliate ;
    pro:isHeldBy _:budi-lee ;
    pro:relatesToOrganization <https://ror.org/05dxgng32> .

# An agent without an identifier is modelled as a blank node.
_:budi-lee
    a foaf:Person ;
    foaf:givenName "Budi" ;
    foaf:familyName "Lee" .

# Tail of the author chain: a named group author with members.
od:role-group-author
    a pro:RoleInTime ;
    pro:withRole pro:author ;
    pro:isHeldBy od:group-who-diabetes .

od:group-who-diabetes
    a foaf:Group ;
    foaf:name "WHO Diabetes Work Group" ;
    foaf:member _:member-sari , _:member-dewi .

# Shared affiliation organizations, identified by ROR IRI and named.
<https://ror.org/0116zj450>
    a foaf:Organization ;
    foaf:name "Universitas Indonesia" .

<https://ror.org/05dxgng32>
    a foaf:Organization ;
    foaf:name "Research Center for Climate Science" .

_:member-sari
    a foaf:Person ;
    foaf:givenName "Sari" ;
    foaf:familyName "Wijaya" .

_:member-dewi
    a foaf:Person ;
    foaf:givenName "Dewi" ;
    foaf:familyName "Suharto" .

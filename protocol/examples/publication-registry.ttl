# OpenDraft Example: Publication Registry
#
# A working example of a publication registry (OD-014). It is a
# fabio:ExpressionCollection whose frbr:part lists publications and
# must not contain other registries.
#
# Validates clean against protocol/registry.shacl.ttl.

@prefix od: <https://w3id.org/opendraft/ontology#> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# The publication registry itself. Lists publications available in a
# collection; the full publication description lives in
# protocol/examples/article.ttl.
<https://example.org/example-publication-registry>
    a fabio:ExpressionCollection ;
    dcterms:title "OpenDraft Example Publication Registry" ;
    dcterms:description "A publication registry containing example publications." ;
    frbr:part <https://example.org/example-publication> .

# The referenced article, typed inline so the frbr:part sh:class
# constraint holds within this file alone.
<https://example.org/example-publication>
    a od:Publication .

# OpenDraft Article SHACL Shapes
#
# Validates that an article RDF graph conforms to the OpenDraft protocol.
# Phase 01: full required field set plus optional-field capability shapes.
# Provenance scalars live directly on od:Publication (see ADR-018).
# Release-only constraints (identifier, FRBR work, od:repositoryUrl,
# od:sourceRevision, and the authorship minimums) live in
# protocol/article-release.shacl.ttl.
# ADR-021: authorship follows the OCDM role model — every role node is
# linked from the publication via pro:isDocumentContextFor, roles are
# held by agents (pro:isHeldBy), and author order is an oco:hasNext
# chain between roles carrying pro:withRole pro:author.
# SHACL Core only (no SHACL-SPARQL); assumes one publication per graph.

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix od: <https://w3id.org/opendraft/ontology#> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doco: <http://purl.org/spar/doco/> .
@prefix deo: <http://purl.org/spar/deo/> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix scoro: <http://purl.org/spar/scoro/> .
@prefix oco: <https://w3id.org/oc/ontology/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix credit: <https://credit.niso.org/contributor-roles/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix datacite: <http://purl.org/datacite/ontology/> .
@prefix literal: <https://w3id.org/literal/> .
@prefix prism: <http://prismstandard.org/namespaces/basic/2.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# Publication Shape — required fields
# =============================================================================

od:PublicationShape
    a sh:NodeShape ;
    sh:targetClass od:Publication ;

    sh:property [
        sh:path dcterms:title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A publication must have exactly one title." ;
    ] ;
    sh:property [
        sh:path od:manuscriptPath ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A publication must have exactly one manuscript path." ;
    ] ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^https://github\\.com/[^/]+/[^/]+/tree/[0-9a-f]{40}/protocol$" ;
        sh:message "A publication must have exactly one dcterms:conformsTo IRI: https://github.com/<owner>/<repo>/tree/<40-character SHA>/protocol." ;
    ] ;
    sh:property [
        sh:path dcterms:hasPart ;
        sh:class doco:Section ;
        sh:message "dcterms:hasPart values must be doco:Section nodes." ;
    ] .
    # Release-only constraints (identifier, frbr:realizationOf,
    # od:repositoryUrl, od:sourceRevision) live in
    # protocol/article-release.shacl.ttl; drafts validate without them.

# =============================================================================
# License and Citation Shapes — warnings (do not affect conformance)
# =============================================================================

od:PublicationLicenseShape
    a sh:NodeShape ;
    sh:targetClass od:Publication ;

    sh:property [
        sh:path dcterms:license ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "A publication should declare a dcterms:license." ;
    ] .

od:PublicationCitationShape
    a sh:NodeShape ;
    sh:targetClass od:Publication ;

    sh:property [
        sh:path cito:cites ;
        sh:not [
            a sh:NodeShape ;
            sh:class fabio:Work ;
        ] ;
        sh:severity sh:Warning ;
        sh:message "cito:cites should target a specific version (version DOI), not the fabio:Work concept." ;
    ] .

# =============================================================================
# Publication Shape — optional fields
# =============================================================================

od:PublicationOptionalShape
    a sh:NodeShape ;
    sh:targetClass od:Publication ;

    sh:property [
        sh:path dcterms:abstract ;
        sh:maxCount 1 ;
        sh:message "A publication may have at most one abstract." ;
    ] .

# =============================================================================
# Publication Shape — informational (non-enforcing) capability notes
# =============================================================================

od:PublicationInfoShape
    a sh:NodeShape ;
    sh:targetClass od:Publication ;
    sh:severity sh:Info ;

    sh:property [
        sh:path fabio:hasSubjectTerm ;
        sh:message "Subject terms may be expressed via fabio:hasSubjectTerm pointing to a SKOS subject term." ;
    ] ;
    sh:property [
        sh:path prism:keyword ;
        sh:message "Keywords are informational and may be expressed via prism:keyword." ;
    ] ;
    sh:property [
        sh:path dcterms:references ;
        sh:message "References may be expressed via dcterms:references." ;
    ] .

# =============================================================================
# Authorship Shapes — OCDM author role model (ADR-021)
#
# Authorship roles are pro:RoleInTime nodes reachable from the
# publication via pro:isDocumentContextFor. The author order is a single
# oco:hasNext chain between roles carrying pro:withRole pro:author.
# The authorship minimums (at least one creator, at least one author
# role, one chain head, one corresponding author with a mailbox) are
# release-only and live in protocol/article-release.shacl.ttl: a draft
# may still be gathering authors (ADR-026). The shapes here only
# constrain roles that exist.
# =============================================================================

od:PublicationAuthorshipShape
    a sh:NodeShape ;
    sh:targetClass od:Publication ;

    # At most one author role heads the chain (no incoming oco:hasNext).
    sh:property [
        sh:path pro:isDocumentContextFor ;
        sh:qualifiedValueShape [
            a sh:NodeShape ;
            sh:property [
                sh:path pro:withRole ;
                sh:hasValue pro:author ;
            ] ;
            sh:property [
                sh:path [ sh:inversePath oco:hasNext ] ;
                sh:maxCount 0 ;
            ] ;
        ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "Exactly one author role may head the oco:hasNext author chain." ;
    ] ;

    # An author role must be held by a named agent (person or group).
    sh:property [
        sh:path pro:isDocumentContextFor ;
        sh:qualifiedValueShape [
            a sh:NodeShape ;
            sh:property [
                sh:path pro:withRole ;
                sh:hasValue pro:author ;
            ] ;
            sh:property [
                sh:path pro:isHeldBy ;
                sh:not [
                    a sh:NodeShape ;
                    sh:or (
                        [ sh:path foaf:familyName ; sh:minCount 1 ]
                        [ sh:path foaf:name ; sh:minCount 1 ]
                    ) ;
                ] ;
            ] ;
        ] ;
        sh:qualifiedMaxCount 0 ;
        sh:message "An author role must be held by an agent with a foaf:familyName or foaf:name." ;
    ] ;

    # A person author must hold a scoro:affiliate role (groups exempt).
    sh:property [
        sh:path pro:isDocumentContextFor ;
        sh:qualifiedValueShape [
            a sh:NodeShape ;
            sh:property [
                sh:path pro:withRole ;
                sh:hasValue pro:author ;
            ] ;
            sh:property [
                sh:path pro:isHeldBy ;
                sh:not [
                    a sh:NodeShape ;
                    sh:or (
                        [ sh:class foaf:Group ]
                        [ sh:property [
                            sh:path [ sh:inversePath pro:isHeldBy ] ;
                            sh:qualifiedValueShape [
                                sh:path pro:withRole ;
                                sh:hasValue scoro:affiliate ;
                            ] ;
                            sh:qualifiedMinCount 1 ;
                        ] ]
                    ) ;
                ] ;
            ] ;
        ] ;
        sh:qualifiedMaxCount 0 ;
        sh:message "A person author must hold a scoro:affiliate role linked to an organization." ;
    ] ;

    # An affiliate role has exactly one organization with a foaf:name;
    # no context role may be an affiliate role lacking one.
    sh:property [
        sh:path pro:isDocumentContextFor ;
        sh:qualifiedValueShape [
            a sh:NodeShape ;
            sh:property [
                sh:path pro:withRole ;
                sh:hasValue scoro:affiliate ;
            ] ;
            sh:not [
                a sh:NodeShape ;
                sh:property [
                    sh:path pro:relatesToOrganization ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                    sh:node [
                        sh:property [
                            sh:path foaf:name ;
                            sh:minCount 1 ;
                        ] ;
                    ] ;
                ] ;
            ] ;
        ] ;
        sh:qualifiedMaxCount 0 ;
        sh:message "An affiliate role must have exactly one organization with a foaf:name." ;
    ] .

# On-behalf-of authors are modeled as an extra scoro:agent role in the
# document context: held by the author (pro:isHeldBy) and related to the
# group (pro:relatesToEntity). It never joins the oco:hasNext chain —
# the chain shapes above only match roles carrying pro:withRole pro:author.
od:AuthorshipRoleShape
    a sh:NodeShape ;
    sh:targetClass pro:RoleInTime ;

    sh:property [
        sh:path pro:isHeldBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every authorship role must have exactly one holder (pro:isHeldBy)." ;
    ] ;
    sh:property [
        sh:path oco:hasNext ;
        sh:maxCount 1 ;
        sh:message "A role may have at most one successor in the author chain (oco:hasNext)." ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath oco:hasNext ] ;
        sh:maxCount 1 ;
        sh:message "A role may have at most one predecessor in the author chain." ;
    ] ;
    sh:property [
        sh:path pro:withRole ;
        sh:in (
            pro:author
            scoro:agent
            scoro:corresponding-author
            scoro:affiliate
            scoro:consortium-author
            credit:conceptualization
            credit:data-curation
            credit:formal-analysis
            credit:funding-acquisition
            credit:investigation
            credit:methodology
            credit:project-administration
            credit:resources
            credit:software
            credit:supervision
            credit:validation
            credit:visualization
            credit:writing-original-draft
            credit:writing-review-editing
        ) ;
        sh:message "Role values (pro:withRole) are restricted to PRO/SCoRO authorship roles and the 14 NISO CRediT roles." ;
    ] .

od:GroupShape
    a sh:NodeShape ;
    sh:targetClass foaf:Group ;

    sh:property [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:message "A foaf:Group author must have a foaf:name." ;
    ] .

# =============================================================================
# Section Shape — manuscript sections (doco:Section, deo roles)
#
# A section is linked from its publication via dcterms:hasPart,
# titled exactly once, carrying at most one deo role class, chained
# to its successor with oco:hasNext, and sourced over https. The
# release-only dcterms:source requirement lives in
# protocol/article-release.shacl.ttl.
# =============================================================================

od:SectionShape
    a sh:NodeShape ;
    sh:targetClass doco:Section ;

    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A section must have exactly one dcterms:title." ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:qualifiedValueShape [
            sh:in (
                deo:Introduction
                deo:Methods
                deo:Results
                deo:Discussion
                deo:Conclusion
                deo:Acknowledgements
                deo:AuthorContribution
                deo:Background
                deo:Biography
                deo:Contribution
                deo:Data
                deo:DatasetDescription
                deo:Dedication
                deo:Epilogue
                deo:Evaluation
                deo:ExternalResourceDescription
                deo:FutureWork
                deo:Materials
                deo:Model
                deo:Motivation
                deo:Postscript
                deo:ProblemStatement
                deo:Prologue
                deo:RelatedWork
                deo:Scenario
                deo:SupplementaryInformationDescription
            ) ;
        ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A section may have at most one deo role class." ;
    ] ;
    sh:property [
        sh:path oco:hasNext ;
        sh:maxCount 1 ;
        sh:class doco:Section ;
        sh:message "A section may have at most one successor section (oco:hasNext)." ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath oco:hasNext ] ;
        sh:maxCount 1 ;
        sh:message "A section may have at most one predecessor section (oco:hasNext)." ;
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://" ;
        sh:message "A section dcterms:source must be an IRI starting with https://." ;
    ] .

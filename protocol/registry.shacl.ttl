# OpenDraft Registry SHACL Shapes
#
# A registry is a fabio:ExpressionCollection. Its frbr:part values must
# be either only publications (a publication registry) or only other
# registries (a collection registry) — never both (OD-013, OD-014).
# Registries replace the deleted od:Registry class hierarchy (ADR-018).

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix od: <https://w3id.org/opendraft/ontology#> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .

# =============================================================================
# Registry Shape
# =============================================================================

od:RegistryShape
    a sh:NodeShape ;
    sh:targetClass fabio:ExpressionCollection ;
    sh:xone (
        [ a sh:NodeShape ;
          sh:property [
              sh:path frbr:part ;
              sh:minCount 1 ;
              sh:class od:Publication ;
              sh:message "A publication registry must only contain publications in frbr:part." ;
          ] ]
        [ a sh:NodeShape ;
          sh:property [
              sh:path frbr:part ;
              sh:minCount 1 ;
              sh:class fabio:ExpressionCollection ;
              sh:message "A collection registry must only contain registries in frbr:part." ;
          ] ]
    ) .

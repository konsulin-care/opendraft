# OpenDraft Ontology
#
# The canonical RDF vocabulary for the OpenDraft protocol.
# Namespace: urn:opendraft:ontology#
# Prefix: od:
#
# The protocol reuses established vocabularies instead of defining
# custom terms where possible (SPAR/OCDM alignment, ADR-021):
#   - SPAR: FaBiO (fabio: Expression, Work, SubjectTerm), FRBR (frbr:
#     realizationOf, revisionOf), PRO (pro: Role, RoleInTime, isHeldBy,
#     withRole), SCoRO (scoro: corresponding-author, affiliate)
#   - OpenCitations: OCO (oco: hasNext for author order); OCDM patterns
#     via the DataCite (datacite:) and Literal (literal:) ontologies
#   - PRISM (prism: versionIdentifier, keyword), FRAPO (frapo: Grant),
#     CiTO (cito: cites), NISO CRediT (credit: contributor roles)
#   - Dublin Core Terms, FOAF, SKOS, PROV-O
#
# Prefixes for reused vocabularies are declared for reference only;
# this ontology does NOT owl:import them (reference-only prefixes).
#
# Custom od: terms cover only what existing vocabularies do not express:
#   - Git-specific provenance (source revision, protocol revision, repository URL)
#   - Registry structure (collection vs publication registries)
#   - Subject assignment reification (who assigned, when)
#   - Author flags: isDeceased, onBehalfOf

@prefix od: <urn:opendraft:ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix pro: <http://purl.org/spar/pro/> .
@prefix scoro: <http://purl.org/spar/scoro/> .
@prefix oco: <https://w3id.org/oc/ontology/> .
@prefix prism: <http://prismstandard.org/namespaces/basic/2.0/> .
@prefix frapo: <http://purl.org/spar/frapo/> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix datacite: <http://purl.org/datacite/ontology/> .
@prefix literal: <https://w3id.org/literal/> .
@prefix credit: <https://credit.niso.org/contributor-roles/> .


# =============================================================================
# CLASSES
# =============================================================================

od:Publication
    rdf:type owl:Class ;
    rdfs:subClassOf fabio:Expression ;
    rdfs:label "Publication" ;
    rdfs:comment "A published version of an article: one fabio:Expression that is the sole frbr:realizationOf a fabio:Work. Identified by its version DOI. Carries repository URL, source revision, protocol revision, and subject assignments." .

od:Registry
    rdf:type owl:Class ;
    rdfs:label "Registry" ;
    rdfs:comment "Abstract base class for publication registries. Registries are either collection registries (referencing other registries) or publication registries (referencing publications). Never both." .

od:CollectionRegistry
    rdf:type owl:Class ;
    rdfs:subClassOf od:Registry ;
    rdfs:label "Collection Registry" ;
    rdfs:comment "A registry that references other registries. Must not directly contain publications." .

od:PublicationRegistry
    rdf:type owl:Class ;
    rdfs:subClassOf od:Registry ;
    rdfs:label "Publication Registry" ;
    rdfs:comment "A registry that references publications. Must not contain other registries." .

od:SubjectAssignment
    rdf:type owl:Class ;
    rdfs:label "Subject Assignment" ;
    rdfs:comment "A reified assertion linking a publication to a SKOS subject concept, with provenance about who assigned it and when. Distinguishes author-declared from indexer-assigned subjects." .


# =============================================================================
# PROPERTIES — Publication provenance (flat scalars, see ADR-018)
# =============================================================================

od:repositoryUrl
    rdf:type owl:DatatypeProperty ;
    rdfs:domain od:Publication ;
    rdfs:range xsd:anyURI ;
    rdfs:label "repository URL" ;
    rdfs:comment "URL of the Git source repository that produced this publication." .

od:sourceRevision
    rdf:type owl:DatatypeProperty ;
    rdfs:domain od:Publication ;
    rdfs:range xsd:string ;
    rdfs:label "source revision" ;
    rdfs:comment "Full 40-character Git commit SHA of the source revision." .

od:protocolRevision
    rdf:type owl:DatatypeProperty ;
    rdfs:domain od:Publication ;
    rdfs:range xsd:string ;
    rdfs:label "protocol revision" ;
    rdfs:comment "Full 40-character Git commit SHA of the OpenDraft protocol revision." .

od:manuscriptPath
    rdf:type owl:DatatypeProperty ;
    rdfs:domain od:Publication ;
    rdfs:range xsd:string ;
    rdfs:label "manuscript path" ;
    rdfs:comment "Path to the manuscript file within the source repository." .


# =============================================================================
# PROPERTIES — Subject assignment (reified pattern)
# =============================================================================

od:hasAssignment
    rdf:type owl:ObjectProperty ;
    rdfs:domain od:Publication ;
    rdfs:range od:SubjectAssignment ;
    rdfs:label "has subject assignment" ;
    rdfs:comment "Links a publication to a subject assignment. Each assignment binds one SKOS subject term to the publication with provenance." .

od:assignedSubject
    rdf:type owl:ObjectProperty ;
    rdfs:domain od:SubjectAssignment ;
    rdfs:range fabio:SubjectTerm ;
    rdfs:label "assigned subject" ;
    rdfs:comment "The SKOS subject term (fabio:SubjectTerm) that was assigned to the publication." .

od:assignedBy
    rdf:type owl:ObjectProperty ;
    rdfs:domain od:SubjectAssignment ;
    rdfs:range foaf:Agent ;
    rdfs:label "assigned by" ;
    rdfs:comment "The agent (person or indexer) who performed the subject assignment." .

od:assignedAt
    rdf:type owl:DatatypeProperty ;
    rdfs:domain od:SubjectAssignment ;
    rdfs:range xsd:dateTime ;
    rdfs:label "assigned at" ;
    rdfs:comment "Timestamp when the subject was assigned." .


# =============================================================================
# PROPERTIES — Author metadata (extending PRO/FOAF)
# =============================================================================

od:isDeceased
    rdf:type owl:DatatypeProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range xsd:boolean ;
    rdfs:label "deceased" ;
    rdfs:comment "True if this person is deceased. Rendered with the ‡ symbol in bylines." .

od:onBehalfOf
    rdf:type owl:ObjectProperty ;
    rdfs:domain pro:RoleInTime ;
    rdfs:range foaf:Agent ;
    rdfs:label "on behalf of" ;
    rdfs:comment "The agent (typically a foaf:Group or consortium) that an author role is held on behalf of." .


# =============================================================================
# PROPERTIES — Registry structure
# =============================================================================

od:containsRegistry
    rdf:type owl:ObjectProperty ;
    rdfs:domain od:CollectionRegistry ;
    rdfs:range od:Registry ;
    rdfs:label "contains registry" ;
    rdfs:comment "A child registry referenced by this collection registry." .

od:containsPublication
    rdf:type owl:ObjectProperty ;
    rdfs:domain od:PublicationRegistry ;
    rdfs:range od:Publication ;
    rdfs:label "contains publication" ;
    rdfs:comment "A publication referenced by this publication registry." .


# =============================================================================
# CREDiT ALIGNMENT — the 14 NISO CRediT contributor roles (ADR-021)
#
# Declared as pro:Role instances so authorship role nodes can point at
# them via pro:withRole. See https://credit.niso.org/.
# =============================================================================

credit:conceptualization a pro:Role ; rdfs:label "Conceptualization" .
credit:data-curation a pro:Role ; rdfs:label "Data Curation" .
credit:formal-analysis a pro:Role ; rdfs:label "Formal Analysis" .
credit:funding-acquisition a pro:Role ; rdfs:label "Funding Acquisition" .
credit:investigation a pro:Role ; rdfs:label "Investigation" .
credit:methodology a pro:Role ; rdfs:label "Methodology" .
credit:project-administration a pro:Role ; rdfs:label "Project Administration" .
credit:resources a pro:Role ; rdfs:label "Resources" .
credit:software a pro:Role ; rdfs:label "Software" .
credit:supervision a pro:Role ; rdfs:label "Supervision" .
credit:validation a pro:Role ; rdfs:label "Validation" .
credit:visualization a pro:Role ; rdfs:label "Visualization" .
credit:writing-original-draft a pro:Role ; rdfs:label "Writing – Original Draft" .
credit:writing-review-editing a pro:Role ; rdfs:label "Writing – Review & Editing" .

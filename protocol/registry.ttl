# OpenDraft Example: Collection Registry
#
# A working example of a collection registry (OD-013). It is a
# fabio:ExpressionCollection that references exactly one child
# registry by IRI and must not directly contain publications.
#
# Validates clean against protocol/registry.shacl.ttl.

@prefix od: <https://w3id.org/opendraft/ontology#> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# The collection registry itself. A discovery root that lists child
# registries instead of publications.
<https://example.org/example-collection-registry>
    a fabio:ExpressionCollection ;
    dcterms:title "OpenDraft Example Collection Registry" ;
    dcterms:description "A top-level collection registry for demonstration purposes." ;
    frbr:part <https://example.org/example-publication-registry> ;
    foaf:homepage <https://github.com/konsulin-care/opendraft> .

# The child publication registry, typed here so this file validates
# standalone: every frbr:part value must be typed, and every
# fabio:ExpressionCollection must itself carry frbr:part values of
# exactly one kind.
<https://example.org/example-publication-registry>
    a fabio:ExpressionCollection ;
    frbr:part <https://example.org/example-publication> .

# The referenced article, typed inline for the same reason. Its full
# description lives in protocol/examples/article.ttl.
<https://example.org/example-publication>
    a od:Publication .

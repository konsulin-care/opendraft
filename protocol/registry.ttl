# OpenDraft Example: Collection Registry
#
# A working example of a collection registry (OD-013). It references
# exactly one child publication registry by IRI and must not directly
# contain publications.
#
# Validates clean against protocol/registry.shacl.ttl.

@prefix od: <urn:opendraft:ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# The collection registry itself. A discovery root that lists child
# registries instead of publications.
od:example-collection-registry
    a od:CollectionRegistry ;
    dcterms:title "OpenDraft Example Collection Registry" ;
    dcterms:description "A top-level collection registry for demonstration purposes." ;
    od:containsRegistry od:example-publication-registry ;
    foaf:homepage <https://github.com/opendraft/opendraft> .
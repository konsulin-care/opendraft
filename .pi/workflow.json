{
  "finalize": {
    "maxPathsPerTask": 5
  },
  "implement": {
    "tests": {
      "scoped": [
        {
          "argv": [
            "pnpm",
            "exec",
            "vitest",
            "run",
            "--passWithNoTests",
            "{tests}"
          ],
          "scope": "files"
        },
        {
          "argv": [
            "pnpm",
            "exec",
            "vitest",
            "run",
            "{tests}"
          ],
          "cwd": "apps/web",
          "scope": "files"
        },
        {
          "argv": [
            "pnpm",
            "run",
            "test"
          ],
          "cwd": "packages/git"
        },
        {
          "argv": [
            "pnpm",
            "run",
            "test"
          ],
          "cwd": "packages/metadata"
        },
        {
          "argv": [
            "pnpm",
            "run",
            "test"
          ],
          "cwd": "packages/rdf"
        },
        {
          "argv": [
            "pnpm",
            "run",
            "test"
          ],
          "cwd": "packages/references"
        },
        {
          "argv": [
            "pnpm",
            "run",
            "test"
          ],
          "cwd": "packages/schema"
        },
        {
          "argv": [
            "pnpm",
            "run",
            "test"
          ],
          "cwd": "packages/workspace"
        },
        {
          "argv": [
            "go",
            "test",
            "{pkgs}"
          ],
          "scope": "packages",
          "cwd": "apps/bff"
        }
      ]
    },
    "commands": {
      "lint-go": [
        "mise",
        "run",
        "lint-go"
      ],
      "govulncheck": [
        "mise",
        "run",
        "govulncheck"
      ],
      "coverage-go": [
        "mise",
        "run",
        "coverage-go"
      ],
      "yamllint-golangci": [
        "mise",
        "exec",
        "--",
        "yamllint",
        "-c",
        ".yamllint.yml",
        ".golangci.yml"
      ]
    }
  }
}
